<?xml version="1.0" encoding="UTF-8"?>
<!--
  CORREÇÃO: o web.xml anterior usava o DTD "web-app 2.3" (antigo), que o
  Tomcat 10 (Jakarta EE) não reconhece — ele era ignorado com warning.
  Agora usa o schema Jakarta EE 6 correto.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>TrabalhoYuGiOh</display-name>

  <!-- Página inicial: redireciona para /list -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

</web-app>
