<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  CORREÇÃO da aplicação no Tomcat (contexto /WEB-yugioh).

  Erro anterior: o docBase apontava para ".../WEB-yugioh/src/webapps",
  pasta que NÃO existe (o webapp real está em "src/main/webapp").
  Com isso o contexto raiz falhava ao iniciar e o navegador mostrava
  "Cannot load 'http://localhost...': Connection refused".

  Agora:
  - docBase correto: src/main/webapp
  - classes compiladas pelo Maven (target/classes) montadas em /WEB-INF/classes
  - dependências (JSTL, driver MySQL) montadas em /WEB-INF/lib
-->
<Context docBase="${catalina.base}/../src/main/webapp">
  <Resources cacheMaxSize="10240">
    <PreResources base="${catalina.base}/../target/classes"
                  className="org.apache.catalina.webresources.DirResourceSet"
                  webAppMount="/WEB-INF/classes"/>
    <PostResources base="${user.home}/.m2/repository/jakarta/servlet/jsp/jstl/jakarta.servlet.jsp.jstl-api/3.0.0/jakarta.servlet.jsp.jstl-api-3.0.0.jar"
                   className="org.apache.catalina.webresources.FileResourceSet"
                   webAppMount="/WEB-INF/lib/jakarta.servlet.jsp.jstl-api-3.0.0.jar"/>
    <PostResources base="${user.home}/.m2/repository/jakarta/el/jakarta.el-api/5.0.0/jakarta.el-api-5.0.0.jar"
                   className="org.apache.catalina.webresources.FileResourceSet"
                   webAppMount="/WEB-INF/lib/jakarta.el-api-5.0.0.jar"/>
    <PostResources base="${user.home}/.m2/repository/org/glassfish/web/jakarta.servlet.jsp.jstl/3.0.1/jakarta.servlet.jsp.jstl-3.0.1.jar"
                   className="org.apache.catalina.webresources.FileResourceSet"
                   webAppMount="/WEB-INF/lib/jakarta.servlet.jsp.jstl-3.0.1.jar"/>
    <PostResources base="${user.home}/.m2/repository/com/mysql/mysql-connector-j/8.3.0/mysql-connector-j-8.3.0.jar"
                   className="org.apache.catalina.webresources.FileResourceSet"
                   webAppMount="/WEB-INF/lib/mysql-connector-j-8.3.0.jar"/>
    <PostResources base="${user.home}/.m2/repository/com/google/protobuf/protobuf-java/3.25.1/protobuf-java-3.25.1.jar"
                   className="org.apache.catalina.webresources.FileResourceSet"
                   webAppMount="/WEB-INF/lib/protobuf-java-3.25.1.jar"/>
  </Resources>
</Context>
